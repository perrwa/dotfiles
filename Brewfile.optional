# Offered in the interactive picker; nothing here installs under
# --non-interactive. `tap` lines are the exception. They are always applied,
# even when nothing from this file is picked, so a picked formula can always
# resolve its tap.

tap "qmk/qmk"
brew "qmk/qmk/qmk"

cask "docker"
cask "docker-desktop"
cask "google-drive"
cask "handbrake"
cask "iina"
cask "logi-options+"
cask "microsoft-edge"
cask "rode-connect"
cask "slack"
cask "zoom"
